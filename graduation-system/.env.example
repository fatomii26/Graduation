# Copy to .env.local for local development. On Vercel add these under Project -> Settings -> Environment Variables.
# Never commit real values. Never prefix a secret with NEXT_PUBLIC_.

# --- Database (any PostgreSQL 15+: Supabase, Azure, or the docker compose container) ----------------------
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543) for the app.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/graduation
# Optional: a direct (non-pooled, port 5432) URL used only by `npm run db:migrate`. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=
# disable = no TLS (local), require = TLS without certificate check (Supabase pooler), verify = TLS + certificate check
DATABASE_SSL=disable

# --- The public address of this site (no trailing slash) -------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- App secret: at least 32 random characters. Signs sessions and codes, and encrypts connection secrets
#     saved in Technical Settings. Generate with:  openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# --- Test helpers. Only work while Technical Settings is in Test mode. Set to false (or remove) in production.
ALLOW_TEST_SHORTCUTS=true

# --- Payments ---------------------------------------------------------------------------------------------
# simulate = built-in pretend payment page (Test mode only; switches itself off in Live mode)
# ccavenue = real CCAvenue checkout
PAYMENT_MODE=simulate
# test or live CCAvenue endpoint
CCAVENUE_ENV=test
# The three CCAvenue credentials. They can also be replaced (write-only) in Technical Settings.
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=

# --- Staff sign-in: Microsoft Entra ID (single tenant) -----------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Email ---------------------------------------------------------------------------------------------
# log  = emails are stored in the outbox and shown in Technical Settings, nothing is sent (development)
# smtp = send through SMTP (Microsoft 365 relay, SendGrid, Resend, Postmark ...)
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MDX Dubai Graduation <graduation@mdx.ac.ae>

# --- Scheduler: the secret the scheduler sends to /api/cron/tick (GitHub Actions, Vercel Cron, Azure) ------
CRON_SECRET=change-me-too
